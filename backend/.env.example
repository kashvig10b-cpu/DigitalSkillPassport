# ==============================================================================
# DIGITAL SKILL PASSPORT — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Note: If no local mongod service is active, backend automatically falls back to in-memory MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/digital_skill_passport
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/digital_skill_passport?retryWrites=true&w=majority

# JSON Web Token Secret & Expiration
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_9948271
JWT_EXPIRE=7d

# Allowed Frontend Client URL (For CORS & Socket.IO)
CLIENT_URL=http://localhost:5173

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
